# .gitignore for Coffee Dashboard (Node.js + Cassandra + Docker)

# Node modules
node_modules/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids/
*.pid
*.seed
.cache/

# Build / output
dist/
build/
coverage/
.nyc_output/

# Env files (do NOT commit secrets)
.env
.env.*.local

# OS / Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# IDE / JetBrains
*.iml

# Docker
docker-compose.override.yml

# Cassandra (local data/metadata if you run it in the repo)
cassandra-data/
cassandra-logs/

# Misc
*.sqlite
*.db

# Ignore local npm / yarn lock backups
package-lock.json.backup
yarn.lock.backup
